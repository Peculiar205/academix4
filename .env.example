# Database
DB_HOST=localhost
DB_NAME=academixsuite
DB_USER=root
DB_PASS=

# App
APP_URL=https://www.academixsuite.com
APP_ENV=development
APP_DEBUG=true

# Payment Gateways
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_TEST_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_LIVE_PUBLIC_KEY=pk_live_xxxxxxxx
PAYSTACK_LIVE_SECRET_KEY=sk_live_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxx

FLUTTERWAVE_TEST_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_TEST_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxx

STRIPE_TEST_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_TEST_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Email
MAIL_DRIVER=smtp
MAIL_HOST=server1.academixsuite.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@academixsuite.com
MAIL_FROM_NAME=AcademixSuite

# SMS
SMS_PROVIDER=twilio
TWILIO_SID=xxxxxxxx
TWILIO_TOKEN=xxxxxxxx
TWILIO_FROM=+1234567890

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=server1.academixsuite.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@academixsuite.com
MAIL_FROM_NAME=AcademixSuite
MAIL_TEST_EMAIL=test@example.com

# SMS Configuration
SMS_PROVIDER=termii
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Academix
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_SENDER_ID=Academix
SMSNG_API_KEY=your_smsng_api_key
SMSNG_SENDER_ID=Academix

# DeepSeek AI — get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Compatibility settings for legacy code referencing GROQ keys
GROQ_API_KEY=your_deepseek_api_key
GROQ_MODEL=deepseek-chat

# Logging
LOG_LEVEL=info
LOG_DIR=/path/to/logs/
LOG_TO_SYSTEM=false

# PDF Configuration
FONT_DIR=/path/to/fonts/
PDF_SAVE_DIR=/path/to/save/pdfs/
